# Optional build-time overrides for `node build.js`.
#
# The normal build reads src/cloud.config.json and needs none of this. Set these
# in your shell (they are NOT read from a .env file automatically) only to build
# against a different Supabase project, e.g. a staging one:
#
#   BIZDOC_SUPABASE_URL=https://<ref>.supabase.co \
#   BIZDOC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... \
#   node build.js
#
# Both values are compiled into the public index.html, so only ever use the
# PUBLISHABLE key here. The build refuses sb_secret_ keys and service_role JWTs.
# Database passwords and the Google OAuth client secret belong in the Supabase
# dashboard only — never in this repository.

BIZDOC_SUPABASE_URL=https://your-project-ref.supabase.co
BIZDOC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
